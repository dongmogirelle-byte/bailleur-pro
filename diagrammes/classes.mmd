}

Utilisateur "1" --> "*" Propriete : gère
Utilisateur "1" --> "*" Locataire : est
Propriete "1" --> "*" Locataire : héberge
Locataire "1" --> "*" Paiement : effectue
Propriete "1" --> "*" Contrat : a
Locataire "1" --> "*" Contrat : signe
Utilisateur "1" --> "*" Notification : reçoit
Propriete *-- Adresse : contient
