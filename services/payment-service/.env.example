# Payment Service Environment Variables

# Port du service
PORT=5004

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bailleur-pro-payment?retryWrites=true&w=majority

# Node Environment
NODE_ENV=development

# JWT Secret (pour la validation des tokens)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
